rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // MASTER ADMIN LIST
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'gKSRL4grGrgragX3UKYIngkTT6C2' || 
        request.auth.uid == 'gHZ9n7s2b9X8fJ2kP3s5t8YxVOE2' ||
        request.auth.token.email == 'asnap5319@gmail.com' ||
        request.auth.token.email == 'ak63315561338@gmail.com'
      );
    }

    // 1. GLOBAL MASTER OVERRIDE (For Admins)
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // 2. PUBLIC ACCESS (Videos and Profiles are Public like Instagram)
    // This allows the feed to load without login for everyone
    match /{path=**}/posts/{postId} {
      allow read, get, list: if true;
      allow write: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
    }

    match /users/{userId} {
      allow read, get: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 3. PRIVATE COLLECTIONS (Login required)
    match /{path=**}/notifications/{notificationId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.recipientId);
      allow write, create: if isAuthenticated();
    }

    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        request.auth.uid == resource.data.recipientId || 
        request.auth.uid == request.auth.uid
      ));
      allow write, create: if isAuthenticated();
    }

    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (request.auth.uid in chatId.split('_') || isAdmin());
    }

    match /user_followers/{userId}/followers/{followerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /user_following/{userId}/following/{followedId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}