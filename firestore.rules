rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'gKSRL4grGrgragX3UKYIngkTT6C2' || 
        request.auth.uid == 'gHZ9n7s2b9X8fJ2kP3s5t8YxVOE2' ||
        request.auth.token.email == 'asnap5319@gmail.com' ||
        request.auth.token.email == 'ak63315561338@gmail.com'
      );
    }

    // Master rule for Admin
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Unified Rule for Users and their subcollections (Posts, Notifications, etc.)
    match /users/{userId} {
      allow read, get: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      match /{collectionName}/{docId} {
        allow read, list: if true;
        allow write, create, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Broad rules for collection groups (needed for Feed)
    match /{path=**}/posts/{postId} {
      allow read, list: if true;
    }
    match /{path=**}/notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.recipientId;
    }
    match /{path=**}/messages/{messageId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.senderId);
    }

    // Reports & Payouts
    match /reports/{reportId} { allow create: if isAuthenticated(); allow read: if isAdmin(); }
    match /payout_requests/{requestId} { allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); allow create: if isAuthenticated(); }
    match /support_tickets/{ticketId} { allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); allow create: if isAuthenticated(); }
    
    // Chats
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (request.auth.uid in chatId.split('_') || isAdmin());
    }

    // Social
    match /user_followers/{userId}/followers/{followerId} { allow read: if true; allow write: if isAuthenticated(); }
    match /user_following/{userId}/following/{followedId} { allow read: if true; allow write: if isAuthenticated(); }
  }
}