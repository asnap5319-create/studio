rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'asnap5319@gmail.com' ||
        request.auth.uid == 'gHZ9n7s2b9X8fJ2kP3s5t8YxVOE2' ||
        request.auth.uid == 'gKSRL4grGrgragX3UKYIngkTT6C2' ||
        request.auth.uid == 'gKSRL4grGrgragX3UKYIngkTT6C2'
      );
    }

    // COLLECTION GROUP RULES - These MUST be defined broadly to support cross-user queries
    match /{path=**}/posts/{postId} {
      allow read: if true;
    }

    match /{path=**}/messages/{messageId} {
      // Allow if user is recipient or sender, critical for Red Dot collectionGroup query
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId || 
        request.auth.uid == resource.data.senderId ||
        isAdmin()
      );
      allow write: if isAuthenticated();
    }

    match /{path=**}/notifications/{notificationId} {
      // Allow if user is recipient, critical for Red Dot collectionGroup query
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId || 
        isAdmin()
      );
      allow write: if isAuthenticated();
    }

    // Standard User Rules
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      match /{allData=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }

      match /posts/{postId} {
        allow read: if true;
        allow create: if isAuthenticated() && (request.auth.uid == userId);
        allow update: if isAuthenticated();
        allow delete: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // Chat Metadata Rules
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (request.auth.uid in chatId.split('_') || isAdmin());
    }

    // Saved Posts Rules
    match /saved_posts/{savedPostId} {
      allow read, write: if isAuthenticated() && (
        (resource == null || resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Global Admin catch-all
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}