rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'asnap5319@gmail.com' ||
        request.auth.uid == 'gHZ9n7s2b9X8fJ2kP3s5t8YxVOE2'
      );
    }

    // User Rules
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
      
      match /{allData=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /posts/{postId} {
        allow read: if true;
        allow create: if isOwner(userId);
        allow update: if isAuthenticated();
        allow delete: if isOwner(userId) || isAdmin();
        
        match /likes/{likeId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
        
        match /comments/{commentId} {
          allow read: if true;
          allow create: if isAuthenticated();
          allow update: if isAuthenticated();
          allow delete: if isOwner(userId) || isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
        }
      }
      
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if isAuthenticated();
      }
    }

    // Chat Rules - Bulletproof permissions for uid1_uid2 format
    match /chats/{chatId} {
      function isParticipant() {
        return isAuthenticated() && (
          request.auth.uid == chatId.split('_')[0] || 
          request.auth.uid == chatId.split('_')[1] || 
          isAdmin()
        );
      }

      allow read, write: if isParticipant();
      
      match /messages/{messageId} {
        allow read: if isParticipant();
        allow write: if isParticipant();
      }
    }

    // Saved Posts Rules
    match /saved_posts/{savedPostId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Support for collectionGroup queries (Red Dot feature)
    match /{path=**}/messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId || 
        request.auth.uid == resource.data.senderId ||
        isAdmin()
      );
    }

    match /{path=**}/posts/{postId} {
        allow read: if true;
    }

    // Follower/Following rules
    match /user_followers/{followedUserId}/followers/{followerUserId} {
      allow read: if true;
      allow write: if isOwner(followerUserId);
    }
    match /user_following/{followerUserId}/following/{followedUserId} {
      allow read: if true;
      allow write: if isOwner(followerUserId);
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}