rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // MASTER ADMIN RULE - Complete access for specifically listed UIDs and Emails
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'gKSRL4grGrgragX3UKYIngkTT6C2' || 
        request.auth.uid == 'gHZ9n7s2b9X8fJ2kP3s5t8YxVOE2' ||
        request.auth.token.email == 'asnap5319@gmail.com' ||
        request.auth.token.email == 'ak63315561338@gmail.com'
      );
    }

    // 1. GLOBAL OVERRIDE FOR ADMINS
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // 2. COLLECTION GROUP RULES - Crucial for Guest Access & Home Feed
    
    // Allow anyone (even guests) to read posts
    match /{path=**}/posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
    }

    // Messages and Notifications are for participants only, but need path=** for collectionGroup queries
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        request.auth.uid == resource.data.recipientId || 
        request.auth.uid == resource.data.senderId
      ));
      allow write: if isAuthenticated();
    }

    match /{path=**}/notifications/{notificationId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.recipientId);
      allow write: if isAuthenticated();
    }

    // 3. STANDARD HIERARCHICAL RULES
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId);
    }

    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (request.auth.uid in chatId.split('_'));
    }

    match /saved_posts/{savedPostId} {
      allow read, write: if isAuthenticated() && (
        (resource == null || resource.data.userId == request.auth.uid)
      );
    }
  }
}