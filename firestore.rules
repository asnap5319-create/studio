rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'asnap5319@gmail.com' ||
        request.auth.uid == 'gHZ9n7s2b9X8fJ2kP3s5t8YxVOE2'
      );
    }

    // User Rules
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      match /{allData=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }

      match /posts/{postId} {
        allow read: if true;
        allow create: if isAuthenticated() && (request.auth.uid == userId);
        allow update: if isAuthenticated();
        allow delete: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        
        match /likes/{likeId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
        
        match /comments/{commentId} {
          allow read: if true;
          allow create: if isAuthenticated();
          allow update: if isAuthenticated();
          allow delete: if (isAuthenticated() && (request.auth.uid == userId || request.auth.uid == resource.data.userId)) || isAdmin();
        }
      }
      
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId);
        allow write: if isAuthenticated();
      }
    }

    // Chat Rules - Fixed using direct ID split check for robust permissions
    match /chats/{chatId} {
      function isChatParticipant() {
        return isAuthenticated() && (request.auth.uid in chatId.split('_'));
      }

      allow read, write: if isChatParticipant() || isAdmin();
      
      match /messages/{messageId} {
        allow read, write: if isChatParticipant() || isAdmin();
      }
    }

    // Saved Posts Rules - Fixed with proper auth mapping
    match /saved_posts/{id} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && (
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Follower/Following rules
    match /user_followers/{followedUserId}/followers/{followerUserId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == followerUserId;
    }
    match /user_following/{followerUserId}/following/{followedUserId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == followerUserId;
    }

    // Collection Group Rules - CRITICAL for Red Dot and Explore
    match /{path=**}/posts/{postId} {
      allow read: if true;
    }

    match /{path=**}/messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId || 
        request.auth.uid == resource.data.senderId ||
        isAdmin()
      );
    }

    // Global Admin catch-all
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}